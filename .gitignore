# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.cache/

# macOS
.DS_Store

# Claude Code / local agent state
.claude/

# Large 3D asset datasets — fetched/installed separately, not version-controlled.
# DO track the small hand-curated pool id-lists under assets/ (essential to retrieval);
# ignore only the heavy install-time blobs (embeddings, full metadata, mesh binaries).
IDSDL/datasets/assets/*.npz
IDSDL/datasets/assets/futurehssd.json
IDSDL/datasets/assets/*.glb
IDSDL/datasets/assets/*.obj
IDSDL/datasets/futurehssd/
# Custom-ingested assets: track metadata + preview PNGs, but NOT the heavy .glb meshes
# (large, fetched out-of-band like the main dataset; see scenes/work/*_attributions.md)
IDSDL/datasets/custom/models/*.glb

# Supplied glb upload bundles + raw gallery selections (scratch; the ingested assets +
# curated pool jsons are the durable artifacts)
/*.zip
/selection.json

# Generated scene outputs and renders
results/
tmp/
frames/
*.blend
*.blend1

# Generated batch-review pages (regenerable via batchgen.py --collect; can be huge)
batch_review*.html
combined_review.html

# Transient scripts emitted by sceneprogexec (random-digit-named, plus *_exec.py)
/[0-9]*.py
*_exec.py

# Planner RAG embedding cache — regenerated from assets/skills.json on first run
# (also exceeds GitHub's 100 MB file-size limit, so it is never committed)
assets/rag_cache.npz

# Documentation site lives in its own repo: github.com/interioragent/docs
docs/

# Linux: Blender binary installation (downloaded at build time via Dockerfile)
blender-*/

# Linux: compiled ELF binary (not source-controlled)
code
