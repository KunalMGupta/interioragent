# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.cache/

# macOS
.DS_Store

# Claude Code / local agent state
.claude/

# Large 3D asset datasets — fetched/installed separately, not version-controlled
IDSDL/datasets/assets/
IDSDL/datasets/futurehssd/

# Generated scene outputs and renders
results/
tmp/
frames/
*.blend
*.blend1

# Generated batch-review pages (regenerable via batchgen.py --collect; can be huge)
batch_review*.html
combined_review.html

# Transient scripts emitted by sceneprogexec (random-digit-named, plus *_exec.py)
/[0-9]*.py
*_exec.py

# Planner RAG embedding cache — regenerated from assets/skills.json on first run
# (also exceeds GitHub's 100 MB file-size limit, so it is never committed)
assets/rag_cache.npz

# Documentation site lives in its own repo: github.com/interioragent/docs
docs/

# Linux: Blender binary installation (downloaded at build time via Dockerfile)
blender-*/

# Linux: compiled ELF binary (not source-controlled)
code
