# Copy to .env (git-ignored). The asset shop reads these; OPENAI_API_KEY may
# also live here, but exporting it in the shell is what most tools expect.

# REQUIRED for everything LLM/VLM: retrieval embeddings, planning, captions, critics.
OPENAI_API_KEY=sk-...

# OPTIONAL — asset shop (python -m IDSDL.shop / acquire="mid"|"high").
# Sketchfab search is public; DOWNLOADING needs a token (free: Settings -> Password & API).
SKETCHFAB_API_TOKEN=

# OPTIONAL — text-to-3D generation source (--source meshy; spends credits).
MESHY_API_KEY=
